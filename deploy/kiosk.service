# Example systemd unit for the local "Kiosk Mode" display (Chromium on the running desktop).
# This version is for the Wayland desktop (labwc) that Raspberry Pi OS uses by default.
#
# Written for user "jp" (uid 1000) and Raspberry Pi OS Bookworm or newer, where the browser is /usr/bin/chromium.
# See README.md → Setup, step 7. Install on the Pi:
#   sudo cp ~/jplayingnow/deploy/kiosk.service /etc/systemd/system/kiosk.service
#   sudo systemctl daemon-reload
# Don't enable it yourself: the settings page ("Display locally") switches it on and off.
#
# Let the web app switch it on/off without a password. Run `sudo visudo -f /etc/sudoers.d/nowplaying`
# and add this as one line:
#   jp ALL=(root) NOPASSWD: /usr/bin/systemctl enable --now kiosk, /usr/bin/systemctl disable --now kiosk, /usr/bin/systemctl enable --now ssh, /usr/bin/systemctl disable --now ssh, /usr/sbin/reboot, /usr/sbin/shutdown
#
# Check it works:  sudo systemctl start kiosk && systemctl status kiosk
#
# X11 desktop instead of Wayland? Replace the two Wayland Environment= lines with
#   Environment=DISPLAY=:0
#   Environment=XAUTHORITY=/home/jp/.Xauthority
# and remove --ozone-platform=wayland from ExecStart.

[Unit]
Description=Local Chromium Kiosk Display
After=graphical.target network-online.target
Wants=graphical.target

[Service]
User=jp
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
# Wait for the web app to answer before opening the browser
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do curl -sf http://localhost:5000/ >/dev/null && exit 0; sleep 1; done; exit 1'
# Older Raspberry Pi OS called the browser /usr/bin/chromium-browser (check with: which chromium chromium-browser)
ExecStart=/usr/bin/chromium --kiosk --ozone-platform=wayland --noerrdialogs --disable-infobars --check-for-update-interval=31536000 http://localhost:5000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
